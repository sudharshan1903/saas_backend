# PORT: HTTP server listening port
PORT=3000

# NODE_ENV: Runtime environment (development | test | production)
NODE_ENV=development

# APP_BASE_URL: Application base URL for links and redirects
APP_BASE_URL=http://localhost:3000

# DATABASE_URL: PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@123@localhost:5433/saasdb

# REDIS_URL: Redis connection URL for queues and caching
REDIS_URL=redis://localhost:6379

# STRIPE_SECRET_KEY: Stripe Secret Key (starts with sk_test_...)
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_secret_key

# STRIPE_WEBHOOK_SECRET: Webhook signing secret (starts with whsec_...)
# Obtained from `stripe listen` command output
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_stripe_webhook_secret

# STRIPE_PRICE_ID: Recurring Stripe Price ID (starts with price_...)
STRIPE_PRICE_ID=price_replace_with_your_recurring_price_id

# CHECKOUT_SUCCESS_URL: Redirect URL after successful Stripe Checkout
CHECKOUT_SUCCESS_URL=http://localhost:3000/checkout/success

# CHECKOUT_CANCEL_URL: Redirect URL when Stripe Checkout is canceled
CHECKOUT_CANCEL_URL=http://localhost:3000/checkout/cancel

# MAIL_HOST: SMTP server host for sending PDF invoice emails
MAIL_HOST=smtp.gmail.com

# MAIL_PORT: SMTP server port (e.g. 587 or 465)
MAIL_PORT=587

# MAIL_USER: SMTP authentication username or email
MAIL_USER=your-email@example.com

# MAIL_PASS: SMTP authentication password or 16-character Google App Password
MAIL_PASS=your-smtp-password

# MAIL_FROM: Sender email address and display name
MAIL_FROM="SaaS Platform <noreply@example.com>"

# ADMIN_API_KEY: Secret key required for protected endpoints (min 16 chars)
ADMIN_API_KEY=secret-admin-key-min-16-chars-long

# INVOICE_LINK_SECRET: HMAC signing key for secure download URLs (min 16 chars)
INVOICE_LINK_SECRET=secret-admin-key-min-16-chars-long

# INVOICE_LINK_TTL_HOURS: Lifetime of signed invoice download URLs in hours
INVOICE_LINK_TTL_HOURS=24

# CRON_SCHEDULE: Cron expression for subscription expiry sweeps (e.g., */1 * * * *)
CRON_SCHEDULE=0 9 * * *

# CRON_TIMEZONE: Timezone for node-cron execution
CRON_TIMEZONE=UTC

# CRON_RUN_ON_START: Run subscription expiry sweep immediately on service start
CRON_RUN_ON_START=false

# REMINDER_DAYS_BEFORE: Number of days before expiration to send reminder email
REMINDER_DAYS_BEFORE=7

# EXPIRY_GRACE_HOURS: Grace period in hours before canceling past-due subscriptions
EXPIRY_GRACE_HOURS=24

# STATS_CACHE_TTL_SECONDS: Redis cache TTL for analytics summary in seconds
STATS_CACHE_TTL_SECONDS=300

# INVOICE_DIR: Local directory path where PDF invoices are saved
INVOICE_DIR=./invoices

# LOG_LEVEL: Pino logger log level (trace | debug | info | warn | error | fatal)
LOG_LEVEL=info

# CORS_ORIGINS: Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# WORKER_CONCURRENCY: BullMQ worker concurrency count
WORKER_CONCURRENCY=2

# COMPANY_NAME: Company display name printed on PDF invoices
COMPANY_NAME="SaaS Platform Inc."

# DEFAULT_CURRENCY: Default 3-letter ISO currency code
DEFAULT_CURRENCY=usd

# Docker compose environment variable overrides (optional)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres@123
POSTGRES_DB=saasdb
POSTGRES_PORT=5433
REDIS_PORT=6379
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050
